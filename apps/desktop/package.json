{
  "name": "jeff-postman",
  "productName": "JEFF Postman",
  "version": "0.1.0",
  "description": "Cliente de API local para Windows",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build -c vite.cli.config.mts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win",
    "test": "vitest run",
    "build:cli": "vite build -c vite.cli.config.mts",
    "cli": "node out/cli/jeff-postman.js",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.65.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chai": "^4.5.0",
    "crypto-js": "^4.2.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tv4": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
